# brew bundle   — system tools the Python packages shell out to.
brew "uv"           # Python + project manager (uv python install 3.14)
brew "poppler"      # pdftotext -layout, pdfinfo, pdftoppm, pdffonts
brew "ghostscript"  # gs: repair / re-write / rasterise damaged PDFs
brew "ffmpeg"       # audio decode for docling ASR (Whisper)
brew "tesseract"    # optional: OCR cross-check; Apple Vision is the default on macOS
