# Copy to .env (never commit .env). Every value is optional except the four marked REQUIRED
# when you run `funicular serve`.

# ---- extraction defaults ----
FUNICULAR_OCR=off                 # off | auto | force   (auto = only pages that look scanned)
FUNICULAR_OCR_BACKEND=auto        # auto | macocr | macocr-cli | tesseract
FUNICULAR_OCR_LANGUAGES=en-US     # comma separated BCP-47; passed to Apple Vision
FUNICULAR_ASR_MODEL=whisper_turbo # docling ASR model; MLX build auto-selected on Apple Silicon
# FUNICULAR_MACOCR_BIN=/opt/homebrew/bin/macocr   # optional CLI OCR fallback

# ---- storage (defaults shown; iCloud Drive is used when present) ----
# FUNICULAR_DATA_DIR=~/.funicular
# FUNICULAR_INBOX_DIR="~/Library/Mobile Documents/com~apple~CloudDocs/Funicular/Inbox"
# FUNICULAR_ARCHIVE_DIR="~/Library/Mobile Documents/com~apple~CloudDocs/Funicular/Archive"
FUNICULAR_WATCH_INBOX=0           # 1 = import anything dropped in the inbox folder

# ---- web app (REQUIRED for serve) ----
FUNICULAR_GITHUB_CLIENT_ID=       # REQUIRED  GitHub App > General > Client ID
FUNICULAR_GITHUB_CLIENT_SECRET=   # REQUIRED  GitHub App > General > Client secrets
FUNICULAR_ALLOWED_GITHUB_IDS=     # REQUIRED  numeric IDs, comma separated (curl https://api.github.com/users/<login> | jq .id)
FUNICULAR_PUBLIC_URL=http://127.0.0.1:8787   # REQUIRED  must be https unless loopback

FUNICULAR_HOST=127.0.0.1          # keep loopback; put Tailscale Serve or Caddy in front for TLS
FUNICULAR_PORT=8787
FUNICULAR_TRUST_PROXY=0           # 1 only when a TLS proxy on this Mac forwards to the app
FUNICULAR_MAX_UPLOAD_MB=512
FUNICULAR_WORKERS=2               # parallel extractions; each can use ~1-2 GB with docling/OCR
FUNICULAR_SESSION_IDLE_MINUTES=720
FUNICULAR_SESSION_ABSOLUTE_HOURS=168
